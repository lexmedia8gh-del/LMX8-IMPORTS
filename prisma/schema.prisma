generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum ShipmentStatus {
  SHIPMENT_CREATED
  PREPARING_SHIPMENT
  SHIPPED
  IN_TRANSIT
  ARRIVED_AT_DESTINATION
  CUSTOMS_CLEARANCE
  OUT_FOR_DELIVERY
  DELIVERED
  ON_HOLD
}

enum TransactionType {
  PURCHASE
  SOURCING_REQUEST
  REFUND
  ADMIN_ADJUSTMENT
  BONUS
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum SourcingStatus {
  PENDING
  QUOTED
  APPROVED
  REJECTED
  PURCHASED
  SHIPPED
}

model Customer {
  id                 String              @id @default(uuid())
  customerIdentifier String              @unique // e.g. LMX8-00125
  name               String
  phone              String?
  email              String?
  status             String              @default("ACTIVE")
  pinHash            String?             // bcrypt hash of 6-digit PIN — never store plaintext
  loginAttempts      Int                 @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  shipments          Shipment[]
  creditAccount      CreditAccount?
  creditTransactions CreditTransaction[]
  sourcingRequests   SourcingRequest[]
  buyForMeRequests   BuyForMeRequest[]
  payments           Payment[]
  notifications      Notification[]
  emailLogs          EmailLog[]
  loginLogs          CustomerLoginLog[]
  pageViews          CustomerPageView[]
  invoices           Invoice[]
}

model AdminUser {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String?  // bcrypt hash — never store plaintext
  pinHash      String?  // bcrypt hash of 6-8 digit PIN
  role         Role     @default(STAFF)
  status       String   @default("ACTIVE")
  loginAttempts Int     @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trackingEvents TrackingEvent[]
  shipmentPhotos ShipmentPhoto[]
  auditLogs      AuditLog[]
  invoicesCreated Invoice[]
  notifications  Notification[]
}

model Batch {
  id             String     @id @default(uuid())
  batchNumber    String     @unique
  name           String
  description    String?
  status         String     @default("OPEN")
  departure      DateTime?
  arrival        DateTime?
  closedAt       DateTime?
  fileDeletionAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  shipments      Shipment[]
  emailLogs      EmailLog[]
}

model Shipment {
  id               String          @id @default(uuid())
  trackingNumber   String          @unique // E.g. SHP-xxxxx
  description      String
  quantity         Int?
  weight           Float?
  status           ShipmentStatus  @default(SHIPMENT_CREATED)
  origin           String?
  destination      String?
  shippingMethod   String?
  estimatedArrival DateTime?
  fee              Float           @default(0.0)
  originalFee      Float?
  discountPercent  Float?          @default(0.0)
  discountAmount   Float?          @default(0.0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id])
  
  batchId          String?
  batch            Batch?          @relation(fields: [batchId], references: [id])

  trackingEvents   TrackingEvent[]
  photos           ShipmentPhoto[]
  payments         Payment[]
  emailLogs        EmailLog[]
  invoices         Invoice[]

  @@index([customerId])
  @@index([batchId])
  @@index([trackingNumber])
}

model TrackingEvent {
  id          String         @id @default(uuid())
  status      ShipmentStatus
  location    String?
  note        String?
  timestamp   DateTime       @default(now())
  createdAt   DateTime       @default(now())

  shipmentId  String
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  adminId     String?
  admin       AdminUser?     @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([timestamp])
}

model ShipmentPhoto {
  id          String     @id @default(uuid())
  bucket      String     @default("shipment-files")
  objectPath  String
  filename    String
  mimeType    String?
  size        Int?
  caption     String?
  status      String     @default("ACTIVE") // ACTIVE, PENDING_DELETION, DELETED
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())

  batchId     String?
  shipmentId  String
  shipment    Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  adminId     String?
  admin       AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([batchId])
  @@index([status])
}

model CreditAccount {
  id               String    @id @default(uuid())
  balance          Int       @default(0) // Balance in credits
  selectedPackage  String?   // Starter, Standard, Premium
  packagePrice     Float     @default(0.0) // Package price in GHS
  creditsPurchased Int       @default(0)   // Total credits purchased
  creditsUsed      Int       @default(0)   // Total credits used
  creditsRemaining Int       @default(0)   // Credits remaining (matches balance)
  lastActivityAt   DateTime? // Last credit activity date
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customerId       String    @unique
  customer         Customer  @relation(fields: [customerId], references: [id])
}

model CreditTransaction {
  id             String          @id @default(uuid())
  type           TransactionType
  amount         Int
  balanceBefore  Int
  balanceAfter   Int
  reference      String?
  description    String?
  createdAt      DateTime        @default(now())

  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id])

  paymentId      String?
  payment        Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([customerId])
}

model SourcingRequest {
  id                         String                 @id @default(uuid())
  requestNumber              String                 @unique
  productDetails             String
  quantity                   Int?
  originalQuantity           Int?
  preferredSizeColor         String?
  additionalInstructions     String?
  status                     SourcingStatus         @default(PENDING)
  creditsUsed                Int                    @default(0)
  adminNotes                 String?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  idempotencyKey             String?                @unique
  unitPrice                  Float?
  totalCost                  Float?
  priceUpdatedAt             DateTime?
  priceUpdatedBy             String?
  priceNotes                 String?
  imageUrl                   String?
  customerConfirmationStatus String?                @default("PENDING")

  isDraft                    Boolean                @default(true)
  publishedAt                DateTime?

  customerId                 String
  customer                   Customer               @relation(fields: [customerId], references: [id])
  priceHistory               SourcingPriceHistory[]
  sourcingItems              SourcingItem[]

  @@index([customerId])
}

model SourcingItem {
  id                String          @id @default(uuid())
  sourcingRequestId String
  sourcingRequest   SourcingRequest @relation(fields: [sourcingRequestId], references: [id], onDelete: Cascade)
  productName       String
  description       String?
  unitPrice         Float           @default(0.0)
  quantity          Int             @default(1)
  subtotal          Float           @default(0.0)
  imageUrl          String?
  isPublished       Boolean         @default(false)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([sourcingRequestId])
}

model SourcingPriceHistory {
  id                String          @id @default(uuid())
  sourcingRequestId String
  sourcingRequest   SourcingRequest @relation(fields: [sourcingRequestId], references: [id], onDelete: Cascade)
  unitPrice         Float
  quantity          Int
  totalCost         Float
  notes             String?
  updatedById       String?
  updatedByName     String?
  createdAt         DateTime        @default(now())

  @@index([sourcingRequestId])
  @@index([createdAt])
}

model BuyForMeRequest {
  id                     String                 @id @default(uuid())
  requestNumber          String                 @unique
  customerId             String
  customer               Customer               @relation(fields: [customerId], references: [id])
  submissionType         String                 @default("MANUAL_LIST") // IMAGE_UPLOAD, MANUAL_LIST, PRODUCT_LINK
  status                 String                 @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, QUOTATION_READY, AWAITING_PAYMENT, PAYMENT_CONFIRMED, PURCHASING_IN_PROGRESS, PURCHASED, SHIPMENT_PROCESSING, COMPLETED, CANCELLED
  additionalInstructions String?
  purchasingPreferences  String?
  deliveryPreferences    String?
  adminNotes             String?
  idempotencyKey         String?                @unique
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  items                  BuyForMeItem[]
  quotations             BuyForMeQuotation[]
  payments               Payment[]
  statusHistory          BuyForMeStatusHistory[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model BuyForMeItem {
  id             String          @id @default(uuid())
  requestId      String
  request        BuyForMeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productName    String
  description    String?
  productUrl     String?
  quantity       Int             @default(1)
  preferredSpecs String?
  budget         Float?
  imageUrl       String?
  unitPrice      Float?
  subtotal       Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([requestId])
}

model BuyForMeQuotation {
  id                String                     @id @default(uuid())
  requestId         String
  request           BuyForMeRequest            @relation(fields: [requestId], references: [id], onDelete: Cascade)
  version           Int                        @default(1)
  status            String                     @default("DRAFT") // DRAFT, PUBLISHED, REVISED, PAID
  totalProductCost  Float                      @default(0.0)
  shippingFee       Float                      @default(0.0)
  sourcingFee       Float                      @default(0.0)
  serviceFee        Float                      @default(0.0)
  otherCharges      Float                      @default(0.0)
  otherChargesNotes String?
  grandTotal        Float                      @default(0.0)
  currency          String                     @default("GHS")
  adminNotes        String?
  publishedAt       DateTime?
  publishedById     String?
  publishedByName   String?
  isPaid            Boolean                    @default(false)
  paidAt            DateTime?
  paymentReference  String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  lineItems         BuyForMeQuotationLineItem[]

  @@index([requestId])
  @@index([status])
  @@index([createdAt])
}

model BuyForMeQuotationLineItem {
  id          String            @id @default(uuid())
  quotationId String
  quotation   BuyForMeQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  itemId      String?
  productName String
  unitPrice   Float             @default(0.0)
  quantity    Int               @default(1)
  subtotal    Float             @default(0.0)
  notes       String?
  createdAt   DateTime          @default(now())

  @@index([quotationId])
}

model BuyForMeStatusHistory {
  id            String          @id @default(uuid())
  requestId     String
  request       BuyForMeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status        String
  note          String?
  changedById   String?
  changedByName String?
  createdAt     DateTime        @default(now())

  @@index([requestId])
}

enum PaymentType {
  CREDIT_PURCHASE
  SHIPPING_FEE
  BUY_FOR_ME
}

model Payment {
  id                    String         @id @default(uuid())
  reference             String         @unique
  amount                Float
  currency              String         @default("GHS")
  status                PaymentStatus  @default(PENDING)
  type                  PaymentType    @default(CREDIT_PURCHASE)
  provider              String?        // e.g., "PAYSTACK"
  providerTransactionId String?
  metadata              Json?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  customerId            String
  customer              Customer       @relation(fields: [customerId], references: [id])
  
  shipmentId            String?
  shipment              Shipment?      @relation(fields: [shipmentId], references: [id])

  buyForMeRequestId     String?
  buyForMeRequest       BuyForMeRequest? @relation(fields: [buyForMeRequestId], references: [id], onDelete: SetNull)
  buyForMeQuotationId   String?

  creditTransactions    CreditTransaction[]

  @@index([customerId])
  @@index([reference])
  @@index([shipmentId])
  @@index([buyForMeRequestId])
}

model AuditLog {
  id          String     @id @default(uuid())
  action      String
  entityType  String
  entityId    String
  description String?
  metadata    Json?
  timestamp   DateTime   @default(now())

  adminId     String?
  admin       AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([entityType, entityId])
}

enum NotificationType {
  SHIPMENT
  PAYMENT
  DELIVERY
  ACCOUNT
  SYSTEM
  SOURCING_REQUEST
  BUY_FOR_ME
}

model Notification {
  id              String           @id @default(uuid())
  customerId      String?
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  adminId         String?
  admin           AdminUser?       @relation(fields: [adminId], references: [id], onDelete: SetNull)
  type            NotificationType @default(SYSTEM)
  title           String
  message         String
  read            Boolean          @default(false)
  actionUrl       String?
  idempotencyKey  String?          @unique
  shipmentId      String?
  paymentId       String?
  sourcingRequestId String?
  buyForMeRequestId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([customerId])
  @@index([adminId])
  @@index([customerId, read])
  @@index([adminId, read])
  @@index([createdAt])
}

model BrandSettings {
  id                 String   @id @default("singleton")
  businessName       String   @default("LMX8 IMPORTS")
  shortName          String   @default("LMX8")
  tagline            String   @default("Your Goods. Our Priority.")
  primaryColor       String   @default("#141B47")
  secondaryColor     String   @default("#355DAF")
  accentColor        String   @default("#F2901F")
  mainLogo           String?  // Storage path or data URL
  lightLogo          String?  // Storage path or data URL
  darkLogo           String?  // Storage path or data URL
  brandMark          String?  // Storage path or data URL
  favicon            String?  // Storage path or data URL
  invoiceLogo        String?  // Storage path or data URL
  invoiceFooterLogo  String?  // Storage path or data URL
  invoiceStamp       String?  // Storage path or data URL
  updatedAt          DateTime @updatedAt
  updatedBy          String?  // Admin User ID
}

enum EmailEventStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model EmailLog {
  id                String           @id @default(uuid())
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shipmentId        String?
  shipment          Shipment?        @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  batchId           String?
  batch             Batch?           @relation(fields: [batchId], references: [id], onDelete: SetNull)
  eventType         String           // SHIPMENT_CREATED, SHIPPED, ARRIVED_AT_DESTINATION, CUSTOMS_CLEARANCE, OUT_FOR_DELIVERY, DELIVERED, SHIPPING_FEE_REMINDER
  status            EmailEventStatus @default(PENDING)
  recipient         String
  subject           String
  providerMessageId String?
  idempotencyKey    String           @unique
  sentAt            DateTime?
  failedAt          DateTime?
  errorMessage      String?
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([customerId])
  @@index([shipmentId])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

model ResetAudit {
  id                 String    @id @default(uuid())
  operationId        String    @unique
  adminId            String
  adminName          String
  adminEmail         String
  resetMode          String    // "ALL_OPERATIONAL" | "SELECTED_CATEGORIES"
  selectedCategories String[]  // e.g. ["SHIPMENTS", "SOURCING_REQUESTS", "BATCHES", "CREDIT_LEDGER", "LOCAL_PAYMENTS", "EMAIL_LOGS_NOTIFICATIONS", "OPERATIONAL_AUDIT_LOGS"]
  countsBefore       Json      // snapshot of counts
  countsAfter        Json      // snapshot of counts
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  status             String    // "SUCCESS" | "FAILED" | "IN_PROGRESS"
  pendingCleanup     Json?     // list of storage files pending cleanup
  errorMessage       String?
  metadata           Json?
  createdAt          DateTime  @default(now())

  @@index([adminId])
  @@index([status])
  @@index([createdAt])
}

model SystemSettings {
  id                      String   @id @default("singleton")
  // General
  defaultTimezone         String   @default("Africa/Accra")
  dateTimeFormat          String   @default("DD/MM/YYYY")
  defaultCurrency         String   @default("GHS")
  // Notifications
  shipmentEmailEnabled    Boolean  @default(true)
  feeReminderEnabled      Boolean  @default(true)
  feeReminderIntervalDays Int      @default(3)
  failedEmailRetryMax     Int      @default(3)
  // Security
  sessionTimeoutMinutes   Int      @default(60)
  maxLoginAttempts        Int      @default(5)
  lockoutDurationMinutes  Int      @default(15)
  // Invoicing & Billing
  defaultPaymentInstructions String?
  updatedAt               DateTime @updatedAt
  updatedBy               String?  // Admin User ID
}

model CustomerLoginLog {
  id                 String   @id @default(uuid())
  customerId         String?
  customerIdentifier String?
  status             String   // "SUCCESS" | "FAILED"
  authMethod         String   @default("PIN") // "CUSTOMER_ID_PIN" | "PHONE_PIN"
  ipAddress          String?
  userAgent          String?
  failureReason      String?
  createdAt          DateTime @default(now())

  customer           Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([customerIdentifier])
}

model CustomerPageView {
  id                 String   @id @default(uuid())
  customerId         String
  customerIdentifier String
  path               String
  title              String?
  sessionId          String?
  createdAt          DateTime @default(now())

  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([path])
  @@index([createdAt])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id                  String         @id @default(uuid())
  invoiceNumber       String         @unique
  accessToken         String         @unique @default(uuid())
  status              InvoiceStatus  @default(DRAFT)
  issueDate           DateTime       @default(now())
  dueDate             DateTime
  currency            String         @default("GHS")
  subtotal            Float          @default(0.0)
  discountAmount      Float          @default(0.0)
  discountPercent     Float?         @default(0.0)
  shippingCharges     Float          @default(0.0)
  handlingCharges     Float          @default(0.0)
  customsCharges      Float          @default(0.0)
  otherCharges        Float          @default(0.0)
  taxRate             Float?         @default(0.0)
  taxAmount           Float          @default(0.0)
  totalAmount         Float          @default(0.0)
  amountPaid          Float          @default(0.0)
  outstandingBalance  Float          @default(0.0)
  paymentInstructions String?
  clientNotes         String?
  internalNotes       String?
  purchaseOrderRef    String?
  freightStatus       String?        @default("CONFIRMED") // PENDING, CONFIRMED, NOT_APPLICABLE
  freightNotes        String?
  lastDeliveryMethod  String?
  lastSentAt          DateTime?
  sentCount           Int            @default(0)

  customerId          String
  customer            Customer       @relation(fields: [customerId], references: [id])

  shipmentId          String?
  shipment            Shipment?      @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  createdById         String?
  createdBy           AdminUser?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  items               InvoiceItem[]
  payments            InvoicePayment[]
  communicationLogs   InvoiceCommunicationLog[]

  @@index([customerId])
  @@index([shipmentId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([accessToken])
  @@index([dueDate])
  @@index([createdAt])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  sku         String?
  quantity    Int      @default(1)
  unitPrice   Float    @default(0.0)
  discount    Float    @default(0.0)
  lineTotal   Float    @default(0.0)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
}

model InvoicePayment {
  id            String   @id @default(uuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Float
  paymentDate   DateTime @default(now())
  paymentMethod String
  reference     String?
  notes         String?
  recordedBy    String?
  createdAt     DateTime @default(now())

  @@index([invoiceId])
  @@index([paymentDate])
}

model InvoiceCommunicationLog {
  id                String   @id @default(uuid())
  invoiceId         String
  invoice           Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  channel           String
  recipient         String
  subject           String?
  status            String
  providerMessageId String?
  errorMessage      String?
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([invoiceId])
  @@index([channel])
  @@index([createdAt])
}

model Expense {
  id             String   @id @default(uuid())
  expenseNumber  String   @unique
  category       String   // CUSTOMS_CLEARANCE, PORT_HANDLING, TRANSPORT_DELIVERY, WAREHOUSE, OFFICE_UTILITIES, PACKAGING, ADMINISTRATIVE, OTHER
  description    String
  amount         Float
  currency       String   @default("GHS")
  paymentMethod  String   @default("CASH") // CASH, BANK_TRANSFER, MTN_MOMO, TELECEL_CASH, CARD, CHEQUE, OTHER
  payee          String?
  reference      String?
  notes          String?
  receiptUrl     String?
  date           DateTime @default(now())
  recordedById   String?
  recordedByName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([date])
  @@index([category])
  @@index([paymentMethod])
  @@index([createdAt])
}

model EodReport {
  id                      String    @id @default(uuid())
  reportNumber            String    @unique
  businessDate            String    // YYYY-MM-DD
  status                  String    @default("DRAFT") // DRAFT, FINALIZED
  openingCash             Float     @default(0.0)
  actualClosingCash       Float?
  expectedClosingCash     Float     @default(0.0)
  cashVariance            Float     @default(0.0)
  totalInvoiced           Float     @default(0.0)
  totalCollections        Float     @default(0.0)
  collectionsByMethod     Json?
  totalExpenses           Float     @default(0.0)
  expensesByCategory      Json?
  netCashMovement         Float     @default(0.0)
  receivablesTotal        Float     @default(0.0)
  invoicesCreatedCount    Int       @default(0)
  invoicesSettledCount    Int       @default(0)
  shipmentsProcessedCount Int       @default(0)
  newClientsCount         Int       @default(0)
  notes                   String?
  preparedByName          String?
  finalizedByName         String?
  finalizedAt             DateTime?
  snapshotData            Json?
  auditTrail              Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([businessDate])
  @@index([status])
  @@index([createdAt])
}
