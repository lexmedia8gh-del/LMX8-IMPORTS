generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum ShipmentStatus {
  SHIPMENT_CREATED
  PREPARING_SHIPMENT
  SHIPPED
  IN_TRANSIT
  ARRIVED_AT_DESTINATION
  CUSTOMS_CLEARANCE
  OUT_FOR_DELIVERY
  DELIVERED
  ON_HOLD
}

enum TransactionType {
  PURCHASE
  SOURCING_REQUEST
  REFUND
  ADMIN_ADJUSTMENT
  BONUS
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum SourcingStatus {
  PENDING
  QUOTED
  APPROVED
  REJECTED
  PURCHASED
  SHIPPED
}

model Customer {
  id                 String              @id @default(uuid())
  customerIdentifier String              @unique // e.g. LMX8-00125
  name               String
  phone              String?
  email              String?
  status             String              @default("ACTIVE")
  pinHash            String?             // bcrypt hash of 6-digit PIN — never store plaintext
  loginAttempts      Int                 @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  shipments          Shipment[]
  creditAccount      CreditAccount?
  creditTransactions CreditTransaction[]
  sourcingRequests   SourcingRequest[]
  payments           Payment[]
  notifications      Notification[]
  emailLogs          EmailLog[]
  authEvents         CustomerAuthEvent[]
  pageViews          CustomerPageView[]
}

model AdminUser {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String?  // bcrypt hash — never store plaintext
  pinHash      String?  // bcrypt hash of 6-8 digit PIN
  role         Role     @default(STAFF)
  status       String   @default("ACTIVE")
  loginAttempts Int     @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trackingEvents TrackingEvent[]
  shipmentPhotos ShipmentPhoto[]
  auditLogs      AuditLog[]
}

model Batch {
  id             String     @id @default(uuid())
  batchNumber    String     @unique
  name           String
  description    String?
  status         String     @default("OPEN")
  departure      DateTime?
  arrival        DateTime?
  closedAt       DateTime?
  fileDeletionAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  shipments      Shipment[]
  emailLogs      EmailLog[]
}

model Shipment {
  id               String          @id @default(uuid())
  trackingNumber   String          @unique // E.g. SHP-xxxxx
  description      String
  quantity         Int?
  weight           Float?
  status           ShipmentStatus  @default(SHIPMENT_CREATED)
  origin           String?
  destination      String?
  shippingMethod   String?
  estimatedArrival DateTime?
  fee              Float           @default(0.0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id])
  
  batchId          String?
  batch            Batch?          @relation(fields: [batchId], references: [id])

  trackingEvents   TrackingEvent[]
  photos           ShipmentPhoto[]
  payments         Payment[]
  emailLogs        EmailLog[]

  @@index([customerId])
  @@index([batchId])
  @@index([trackingNumber])
}

model TrackingEvent {
  id          String         @id @default(uuid())
  status      ShipmentStatus
  location    String?
  note        String?
  timestamp   DateTime       @default(now())
  createdAt   DateTime       @default(now())

  shipmentId  String
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  adminId     String?
  admin       AdminUser?     @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([timestamp])
}

model ShipmentPhoto {
  id          String     @id @default(uuid())
  bucket      String     @default("shipment-files")
  objectPath  String
  filename    String
  mimeType    String?
  size        Int?
  caption     String?
  status      String     @default("ACTIVE") // ACTIVE, PENDING_DELETION, DELETED
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())

  batchId     String?
  shipmentId  String
  shipment    Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  adminId     String?
  admin       AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([batchId])
  @@index([status])
}

model CreditAccount {
  id               String    @id @default(uuid())
  balance          Int       @default(0) // Balance in credits
  selectedPackage  String?   // Starter, Standard, Premium
  packagePrice     Float     @default(0.0) // Package price in GHS
  creditsPurchased Int       @default(0)   // Total credits purchased
  creditsUsed      Int       @default(0)   // Total credits used
  creditsRemaining Int       @default(0)   // Credits remaining (matches balance)
  lastActivityAt   DateTime? // Last credit activity date
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customerId       String    @unique
  customer         Customer  @relation(fields: [customerId], references: [id])
}

model CreditTransaction {
  id             String          @id @default(uuid())
  type           TransactionType
  amount         Int
  balanceBefore  Int
  balanceAfter   Int
  reference      String?
  description    String?
  createdAt      DateTime        @default(now())

  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id])

  paymentId      String?
  payment        Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([customerId])
}

model SourcingRequest {
  id                     String          @id @default(uuid())
  requestNumber          String          @unique
  productDetails         String
  quantity               Int?
  preferredSizeColor     String?
  additionalInstructions String?
  status                 SourcingStatus  @default(PENDING)
  creditsUsed            Int             @default(0)
  adminNotes             String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  idempotencyKey         String?         @unique

  customerId             String
  customer               Customer        @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

enum PaymentType {
  CREDIT_PURCHASE
  SHIPPING_FEE
}

model Payment {
  id                    String         @id @default(uuid())
  reference             String         @unique
  amount                Float
  currency              String         @default("GHS")
  status                PaymentStatus  @default(PENDING)
  type                  PaymentType    @default(CREDIT_PURCHASE)
  provider              String?        // e.g., "PAYSTACK"
  providerTransactionId String?
  metadata              Json?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  customerId            String
  customer              Customer       @relation(fields: [customerId], references: [id])
  
  shipmentId            String?
  shipment              Shipment?      @relation(fields: [shipmentId], references: [id])

  creditTransactions    CreditTransaction[]

  @@index([customerId])
  @@index([reference])
  @@index([shipmentId])
}

model AuditLog {
  id          String     @id @default(uuid())
  action      String
  entityType  String
  entityId    String
  description String?
  metadata    Json?
  timestamp   DateTime   @default(now())

  adminId     String?
  admin       AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([entityType, entityId])
}

enum NotificationType {
  SHIPMENT
  PAYMENT
  DELIVERY
  ACCOUNT
  SYSTEM
}

model Notification {
  id              String           @id @default(uuid())
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type            NotificationType @default(SYSTEM)
  title           String
  message         String
  read            Boolean          @default(false)
  actionUrl       String?
  idempotencyKey  String?          @unique
  shipmentId      String?
  paymentId       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([customerId])
  @@index([customerId, read])
  @@index([createdAt])
}

model BrandSettings {
  id                 String   @id @default("singleton")
  businessName       String   @default("LMX8 IMPORTS")
  shortName          String   @default("LMX8")
  tagline            String   @default("Your Goods. Our Priority.")
  primaryColor       String   @default("#141B47")
  secondaryColor     String   @default("#355DAF")
  accentColor        String   @default("#F2901F")
  mainLogo           String?  // Storage path or data URL
  lightLogo          String?  // Storage path or data URL
  darkLogo           String?  // Storage path or data URL
  brandMark          String?  // Storage path or data URL
  favicon            String?  // Storage path or data URL
  invoiceLogo        String?  // Storage path or data URL
  invoiceFooterLogo  String?  // Storage path or data URL
  invoiceStamp       String?  // Storage path or data URL
  updatedAt          DateTime @updatedAt
  updatedBy          String?  // Admin User ID
}

enum EmailEventStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model EmailLog {
  id                String           @id @default(uuid())
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shipmentId        String?
  shipment          Shipment?        @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  batchId           String?
  batch             Batch?           @relation(fields: [batchId], references: [id], onDelete: SetNull)
  eventType         String           // SHIPMENT_CREATED, SHIPPED, ARRIVED_AT_DESTINATION, CUSTOMS_CLEARANCE, OUT_FOR_DELIVERY, DELIVERED, SHIPPING_FEE_REMINDER
  status            EmailEventStatus @default(PENDING)
  recipient         String
  subject           String
  providerMessageId String?
  idempotencyKey    String           @unique
  sentAt            DateTime?
  failedAt          DateTime?
  errorMessage      String?
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([customerId])
  @@index([shipmentId])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

model ResetAudit {
  id                 String    @id @default(uuid())
  operationId        String    @unique
  adminId            String
  adminName          String
  adminEmail         String
  resetMode          String    // "ALL_OPERATIONAL" | "SELECTED_CATEGORIES"
  selectedCategories String[]  // e.g. ["SHIPMENTS", "SOURCING_REQUESTS", "BATCHES", "CREDIT_LEDGER", "LOCAL_PAYMENTS", "EMAIL_LOGS_NOTIFICATIONS", "OPERATIONAL_AUDIT_LOGS"]
  countsBefore       Json      // snapshot of counts
  countsAfter        Json      // snapshot of counts
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  status             String    // "SUCCESS" | "FAILED" | "IN_PROGRESS"
  pendingCleanup     Json?     // list of storage files pending cleanup
  errorMessage       String?
  metadata           Json?
  createdAt          DateTime  @default(now())

  @@index([adminId])
  @@index([status])
  @@index([createdAt])
}

model SystemSettings {
  id                      String   @id @default("singleton")
  // General
  defaultTimezone         String   @default("Africa/Accra")
  dateTimeFormat          String   @default("DD/MM/YYYY")
  defaultCurrency         String   @default("GHS")
  // Notifications
  shipmentEmailEnabled    Boolean  @default(true)
  feeReminderEnabled      Boolean  @default(true)
  feeReminderIntervalDays Int      @default(3)
  failedEmailRetryMax     Int      @default(3)
  // Security
  sessionTimeoutMinutes   Int      @default(60)
  maxLoginAttempts        Int      @default(5)
  lockoutDurationMinutes  Int      @default(15)
  updatedAt               DateTime @updatedAt
  updatedBy               String?  // Admin User ID
}

model CustomerAuthEvent {
  id                 String    @id @default(uuid())
  customerId         String?
  customerIdentifier String?
  method             String    @default("PIN")
  outcome            String    // "SUCCESS" | "FAILED" | "LOCKED"
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime  @default(now())

  customer           Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([customerIdentifier])
  @@index([outcome])
  @@index([createdAt])
}

model CustomerPageView {
  id         String   @id @default(uuid())
  customerId String
  path       String
  pageTitle  String?
  sessionRef String?
  createdAt  DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([path])
  @@index([createdAt])
}


